# Copy to .env and adjust. Every value below is optional: with no .env at all the
# stack runs entirely offline using its fallback backends.

# ---------------------------------------------------------------------------
# Layer 4: LLM
# ---------------------------------------------------------------------------
# auto   = use Ollama when reachable, otherwise the offline extractive provider
# ollama = require Ollama, fail loudly when it is missing
# echo   = always use the offline provider
ZEROSTACK_LLM_PROVIDER=auto
ZEROSTACK_LLM_MODEL=gemma3:4b
ZEROSTACK_LLM_BASE_URL=http://localhost:11434
ZEROSTACK_LLM_TEMPERATURE=0.2
ZEROSTACK_LLM_MAX_TOKENS=1024

# ---------------------------------------------------------------------------
# Layer 3: RAG
# ---------------------------------------------------------------------------
# auto | qdrant | chroma | memory
ZEROSTACK_RAG_BACKEND=auto
ZEROSTACK_RAG_QDRANT_URL=http://localhost:6333
# Where embedded Qdrant stores files when no server is reachable.
ZEROSTACK_RAG_QDRANT_PATH=data/qdrant
ZEROSTACK_RAG_COLLECTION=zerostack
# auto | sentence-transformers | hashing
ZEROSTACK_RAG_EMBEDDING_BACKEND=auto
ZEROSTACK_RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ZEROSTACK_RAG_EMBEDDING_DIMENSIONS=384
ZEROSTACK_RAG_CHUNK_SIZE=800
ZEROSTACK_RAG_CHUNK_OVERLAP=120
ZEROSTACK_RAG_TOP_K=4
ZEROSTACK_RAG_RELEVANCE_RATIO=0.5
# Directories the API may ingest from, comma separated JSON list. Empty means the
# corpus directory only. Widen this deliberately: any directory listed here can be
# read by anyone who can reach the ingest endpoint.
# ZEROSTACK_RAG_ALLOWED_INGEST_ROOTS=["data/corpus","/srv/company-docs"]

# ---------------------------------------------------------------------------
# Layer 2: Orchestrator
# ---------------------------------------------------------------------------
# auto | langgraph | crewai | simple
ZEROSTACK_ORCHESTRATOR_KIND=auto
ZEROSTACK_ORCHESTRATOR_MAX_STEPS=6
ZEROSTACK_ORCHESTRATOR_ENABLE_TOOLS=true

# ---------------------------------------------------------------------------
# Layer 7: Data
# ---------------------------------------------------------------------------
ZEROSTACK_DATA_SQLITE_PATH=data/zerostack.db
ZEROSTACK_DATA_DUCKDB_PATH=data/analytics.duckdb
# Set both to move application state to Supabase. Leave empty for local SQLite.
ZEROSTACK_DATA_SUPABASE_URL=
ZEROSTACK_DATA_SUPABASE_KEY=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
ZEROSTACK_OBS_ENABLED=true
ZEROSTACK_OBS_EXPORT_TRACES=false
ZEROSTACK_OBS_PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
ZEROSTACK_OBS_LOG_LEVEL=INFO
