# Copy to .env and adjust. Every value below is optional: with no .env at all the
# stack runs entirely offline using its fallback backends.

# ---------------------------------------------------------------------------
# Layer 4: LLM
# ---------------------------------------------------------------------------
# auto   = use Ollama when reachable, otherwise the offline extractive provider
# ollama = require Ollama, fail loudly when it is missing
# echo   = always use the offline provider
ZEROSTACK_LLM_PROVIDER=auto
ZEROSTACK_LLM_MODEL=gemma3:4b
ZEROSTACK_LLM_BASE_URL=http://localhost:11434
ZEROSTACK_LLM_TEMPERATURE=0.2
ZEROSTACK_LLM_MAX_TOKENS=1024

# ---------------------------------------------------------------------------
# Layer 3: RAG
# ---------------------------------------------------------------------------
# auto | qdrant | chroma | memory
ZEROSTACK_RAG_BACKEND=auto
ZEROSTACK_RAG_QDRANT_URL=http://localhost:6333
# Where embedded Qdrant stores files when no server is reachable.
ZEROSTACK_RAG_QDRANT_PATH=data/qdrant
ZEROSTACK_RAG_COLLECTION=zerostack
# auto | sentence-transformers | hashing
ZEROSTACK_RAG_EMBEDDING_BACKEND=auto
ZEROSTACK_RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ZEROSTACK_RAG_EMBEDDING_DIMENSIONS=384
ZEROSTACK_RAG_CHUNK_SIZE=800
ZEROSTACK_RAG_CHUNK_OVERLAP=120
ZEROSTACK_RAG_TOP_K=4
ZEROSTACK_RAG_RELEVANCE_RATIO=0.5
# auto and hybrid fuse the keyword and vector tiers. Keyword finds exact terms a
# vector index never saw, such as part numbers and error codes; vector finds
# meaning. Neither alone is sufficient on real documents.
ZEROSTACK_RAG_RETRIEVAL_MODE=auto
ZEROSTACK_RAG_KEYWORD_WEIGHT=1.0
ZEROSTACK_RAG_VECTOR_WEIGHT=1.0
# The graph tier answers questions whose answer is spread across documents that
# never mention each other. It contributes nothing when it recognises no entity
# in the question, so leaving it on costs nothing.
ZEROSTACK_RAG_GRAPH_ENABLED=true
ZEROSTACK_RAG_GRAPH_HOPS=2
# Directories the API may ingest from, comma separated JSON list. Empty means the
# corpus directory only. Widen this deliberately: any directory listed here can be
# read by anyone who can reach the ingest endpoint.
# ZEROSTACK_RAG_ALLOWED_INGEST_ROOTS=["data/corpus","/srv/company-docs"]

# ---------------------------------------------------------------------------
# Layer 2: Orchestrator
# ---------------------------------------------------------------------------
# auto | langgraph | crewai | simple
ZEROSTACK_ORCHESTRATOR_KIND=auto
ZEROSTACK_ORCHESTRATOR_MAX_STEPS=6
ZEROSTACK_ORCHESTRATOR_ENABLE_TOOLS=true

# ---------------------------------------------------------------------------
# Layer 7: Data
# ---------------------------------------------------------------------------
ZEROSTACK_DATA_SQLITE_PATH=data/zerostack.db
ZEROSTACK_DATA_DUCKDB_PATH=data/analytics.duckdb
# Set both to move application state to Supabase. Leave empty for local SQLite.
ZEROSTACK_DATA_SUPABASE_URL=
ZEROSTACK_DATA_SUPABASE_KEY=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
ZEROSTACK_OBS_ENABLED=true
ZEROSTACK_OBS_EXPORT_TRACES=false
ZEROSTACK_OBS_PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
ZEROSTACK_OBS_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Cost accounting
# ---------------------------------------------------------------------------
ZEROSTACK_COST_ENABLED=true
# Zero means no ceiling. A ceiling is checked before a call, not after, so that
# it is a limit rather than a report of the overspend.
ZEROSTACK_COST_DAILY_TOKEN_BUDGET=0
ZEROSTACK_COST_DAILY_COST_BUDGET_USD=0.0
# Per million tokens, "model:prompt:completion", comma separated. Prices change
# often, so they are configuration rather than constants.
# ZEROSTACK_COST_PRICE_TABLE=hosted-model:3.0:15.0,small-model:0.25:1.25

# ---------------------------------------------------------------------------
# Semantic answer cache
# ---------------------------------------------------------------------------
ZEROSTACK_CACHE_ENABLED=true
# High by default. A loose threshold serves the answer to a question that merely
# resembles the one asked, which is a correctness bug dressed as a speed win.
ZEROSTACK_CACHE_THRESHOLD=0.95
ZEROSTACK_CACHE_MAX_ENTRIES=500
ZEROSTACK_CACHE_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Security: identity, tenancy and rate limiting
# ---------------------------------------------------------------------------
# Empty means authentication is OFF and every caller is a local administrator.
# That is right for one machine and wrong for anything exposed. `zerostack
# doctor` states which mode is active rather than leaving it implied.
#
# A JSON mapping of API key to principal. Roles are ordered: reader, writer,
# operator, admin. Namespaces are the tenancy boundary; "*" means all.
# ZEROSTACK_SECURITY_PRINCIPALS={"zs_key":{"name":"hr-app","role":"writer","namespaces":["hr"],"requests_per_minute":60}}
# ZEROSTACK_SECURITY_PRINCIPALS_FILE=/etc/zerostack/principals.json
ZEROSTACK_SECURITY_DEFAULT_NAMESPACE=default
# Zero disables the limiter. An endpoint that runs a model on every call is a
# denial of wallet as much as a denial of service.
ZEROSTACK_SECURITY_REQUESTS_PER_MINUTE=0
