#!/usr/bin/env bash
# Zerostack commit-msg hook.
# Enable with: git config core.hooksPath .githooks
#
# The pre-commit hook scans staged file diffs, which never include the commit
# message. The attribution rule covers commit messages explicitly, so without
# this hook the trailer it forbids could be committed unchallenged.

set -euo pipefail

message_file="$1"
[ -f "$message_file" ] || exit 0

# Ignore comment lines, which git strips from the final message anyway.
body=$(grep -v '^#' "$message_file" || true)

# Matched by shape rather than by vendor name, the same as the pre-commit hook:
# 1. a co-authored-by trailer crediting a bot, assistant or model account
# 2. "generated by/with" crediting an assistant, agent, model or LLM
# 3. the robot emoji banner that usually accompanies them
attribution_re='(co-authored-by:[[:space:]]*[^<]*(bot|assistant|\[ai\]|noreply@)|generated[[:space:]]+(by|with)[[:space:]]+(an?[[:space:]]+)?(ai|a\.i\.|assistant|agent|llm|language model|copilot)|\xf0\x9f\xa4\x96)'

if printf '%s' "$body" | grep -qEi "$attribution_re"; then
  echo "commit-msg: AI attribution found in the commit message (ADR GLOBAL-001)"
  printf '%s' "$body" | grep -nEi "$attribution_re" | head -5
  echo "commit-msg: remove the trailer or banner and commit again"
  exit 1
fi

# ADR GLOBAL-003: the dash policy applies to commit messages as well as files.
# Reuse the checker the hook and CI already share rather than reimplementing the
# match in shell, where the escaping for these code points is easy to get wrong
# and fails silently when it is.
stripped=$(mktemp)
trap 'rm -f "$stripped"' EXIT
printf '%s\n' "$body" > "$stripped"
if ! python3 scripts/check_emdash.py "$stripped" >/dev/null 2>&1; then
  echo "commit-msg: banned dash character in the commit message (ADR GLOBAL-003)"
  python3 scripts/check_emdash.py "$stripped" | head -4
  echo "commit-msg: replace with a comma, colon or period"
  exit 1
fi

exit 0
