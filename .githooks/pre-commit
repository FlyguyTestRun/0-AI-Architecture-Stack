#!/usr/bin/env bash
# Zerostack pre-commit hook.
# Enable with: git config core.hooksPath .githooks

set -euo pipefail

echo "pre-commit: checking staged files"

staged=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$staged" ]; then
  exit 0
fi

# ADR GLOBAL-003: no em dashes in committed text.
# shellcheck disable=SC2086
python3 scripts/check_emdash.py $staged || {
  echo "pre-commit: blocked by the dash policy (ADR GLOBAL-003)"
  exit 1
}

# ADR GLOBAL-001: no AI attribution or assistant branding in committed content.
#
# The patterns below are matched by shape rather than by vendor name, so this hook
# names no product and keeps working as tooling changes. The policy files quote the
# rule itself, so they are exempt or the hook would flag its own definition.
is_policy_file() {
  case "$1" in
    AGENTS.md|.githooks/pre-commit|scripts/check_emdash.py|docs/adr/*) return 0 ;;
    *) return 1 ;;
  esac
}

# 1. a co-authored-by trailer crediting a bot, assistant or model account
# 2. "generated by/with" crediting an assistant, agent, model or LLM
# 3. the robot emoji banner that usually accompanies both
attribution_re='^\+.*(co-authored-by:[[:space:]]*[^<]*(bot|assistant|\[ai\]|noreply@)|generated[[:space:]]+(by|with)[[:space:]]+(an?[[:space:]]+)?(ai|a\.i\.|assistant|agent|llm|language model|copilot)|\xf0\x9f\xa4\x96[[:space:]]*generated)'
violations=0

for file in $staged; do
  if is_policy_file "$file"; then
    continue
  fi
  if git diff --cached -- "$file" | grep -qEi "$attribution_re"; then
    echo "pre-commit: AI attribution found in $file"
    git diff --cached -- "$file" | grep -nEi "$attribution_re" | head -5
    violations=$((violations + 1))
  fi
done

if [ "$violations" -gt 0 ]; then
  echo "pre-commit: blocked by the attribution policy (ADR GLOBAL-001)"
  exit 1
fi

# ADR GLOBAL-001 covers the commit's own author field too. An assistant account
# in the author slot credits one as plainly as a trailer does, and it is the name
# shown beside every commit in the history and on every pull request, which is
# the most visible place the rule can be broken. Matched by shape, as above.
#
# A github user noreply address belongs to a person, so it is stripped before the
# vendor noreply test rather than being flagged.
author_ident="$(git var GIT_AUTHOR_IDENT)"
author_probe="${author_ident//@users.noreply.github.com/}"
author_re='(^|[^[:alnum:]])(bot|assistant|copilot|\[ai\])([^[:alnum:]]|$)|noreply@'
if printf '%s' "$author_probe" | grep -qEi "$author_re"; then
  echo "pre-commit: the commit author reads as an assistant account:"
  echo "    $author_ident"
  echo "pre-commit: set a human author with:"
  echo "    git config user.name \"Your Name\""
  echo "    git config user.email \"you@example.com\""
  echo "pre-commit: blocked by the attribution policy (ADR GLOBAL-001)"
  exit 1
fi

if [ -x .venv/bin/ruff ]; then
  .venv/bin/ruff check src tests apps
fi

echo "pre-commit: ok"
